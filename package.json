{
  "name": "qoherent-website",
  "description": "Qoherent company website",
  "version": "1.10.2",
  "license": "MIT",
  "author": "Qoherent Inc.",
  "scripts": {
    "dev": "hugo server",
    "build": "hugo --gc --minify --templateMetrics --templateMetricsHints --forceSyncStatic",
    "preview": "hugo server --disableFastRender --navigateToChanged --templateMetrics --templateMetricsHints --watch --forceSyncStatic -e production --minify",
    "update-modules": "node ./scripts/clearModules.js && hugo mod clean --all && hugo mod get -u ./... && hugo mod tidy",
    "format": "prettier -w .",
    "check:build": "hugo --gc --environment production --baseURL / --destination .hugo-validation --printPathWarnings --printI18nWarnings",
    "check:html": "html-validate '.hugo-validation/**/*.html'",
    "check:serve": "serve .hugo-validation --listen 1314 --no-clipboard",
    "check:links": "start-server-and-test check:serve http://localhost:1314 \"linkinator http://localhost:1314 --recurse --check-fragments --skip '^(https?:)?//(?!localhost:1314)'\"",
    "check:markdown": "markdownlint-cli2 'content/**/*.md'",
    "check:format": "prettier --check .",
    "check": "npm run check:format && npm run check:build && npm run check:html && npm run check:links && npm run check:markdown && npm audit --audit-level=moderate"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "html-validate": "^11.8.0",
    "linkinator": "^8.0.4",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.1.1",
    "prettier-plugin-go-template": "0.0.15",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.12",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.3"
  }
}
